# Copy to .env for local development:  Copy-Item .env.example .env
# NEVER commit .env. No API keys are needed for this project.

# Local server (python app.py). In production the host sets PORT and gunicorn binds to it.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Optional overrides (defaults shown)
# NEWSGUARD_MODEL_PATH=models/newsguard_pipeline.joblib
# NEWSGUARD_METADATA_PATH=models/model_metadata.json
# NEWSGUARD_DATA_DIR=data
# MAX_CONTENT_LENGTH=262144
# MAX_TEXT_CHARS=20000
# MAX_TITLE_CHARS=300
# MIN_INPUT_CHARS=20
